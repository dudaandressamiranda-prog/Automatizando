# Copie para .env e preencha com os dados do projeto Supabase do Catálogo
# (Settings → API no painel do Supabase). NUNCA commite o .env.

SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role: só é usada por este script, rodando na sua máquina.
# Ela ignora RLS — não use essa chave no app React.
SUPABASE_SERVICE_ROLE_KEY=
