# Copie para .env e preencha (Settings → API no painel do Supabase).
# Aqui vai a chave `anon` (pública) — NUNCA a service_role.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Emails que enxergam a área administrativa (cadastrar/revisar/logs),
# separados por vírgula. Se vazio, o único usuário logado é tratado como
# admin. Ex.: VITE_ADMIN_EMAILS=duda@exemplo.com,socio@exemplo.com
VITE_ADMIN_EMAILS=
